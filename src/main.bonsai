<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:beh="clr-namespace:Harp.Behavior;assembly=Harp.Behavior"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:port="clr-namespace:Bonsai.IO.Ports;assembly=Bonsai.System"
                 xmlns:wie="clr-namespace:Bonsai.Windows.Input;assembly=Bonsai.Windows.Input"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System"
                 xmlns:drw="clr-namespace:Bonsai.Vision.Drawing;assembly=Bonsai.Vision"
                 xmlns:spk="clr-namespace:Bonsai.Spinnaker;assembly=Bonsai.Spinnaker"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Disable">
        <Builder xsi:type="GroupWorkflow">
          <Name>FLIGHTDECK</Name>
          <Workflow>
            <Nodes>
              <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Logging:LogController.bonsai">
                <SubjectId>Algernon</SubjectId>
                <SessionId>001</SessionId>
                <Path>C:\LocalData</Path>
              </Expression>
              <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.Timestamps.bonsai">
                <EventsSubjectName>BehaviorEvents</EventsSubjectName>
                <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
              </Expression>
              <Expression xsi:type="SubscribeSubject">
                <Name>FrameEvents</Name>
              </Expression>
              <Expression xsi:type="MemberSelector">
                <Selector>Value.Image</Selector>
              </Expression>
              <Expression xsi:type="Disable">
                <Builder xsi:type="SubscribeSubject">
                  <Name>LickStateL</Name>
                </Builder>
              </Expression>
              <Expression xsi:type="Disable">
                <Builder xsi:type="SubscribeSubject">
                  <Name>LickStateR</Name>
                </Builder>
              </Expression>
              <Expression xsi:type="Disable">
                <Builder xsi:type="ExternalizedMapping">
                  <Property Name="Value" />
                </Builder>
              </Expression>
              <Expression xsi:type="Disable">
                <Builder xsi:type="GroupWorkflow">
                  <Name>Threshold</Name>
                  <Workflow>
                    <Nodes>
                      <Expression xsi:type="SubscribeSubject">
                        <Name>BC Camera</Name>
                      </Expression>
                      <Expression xsi:type="Combinator">
                        <Combinator xsi:type="dsp:Sum" />
                      </Expression>
                      <Expression xsi:type="MemberSelector">
                        <Selector>Val0</Selector>
                      </Expression>
                      <Expression xsi:type="Subtract">
                        <Operand xsi:type="DoubleProperty">
                          <Value>1000000</Value>
                        </Operand>
                      </Expression>
                      <Expression xsi:type="Divide">
                        <Operand xsi:type="DoubleProperty">
                          <Value>10000000</Value>
                        </Operand>
                      </Expression>
                      <Expression xsi:type="ExternalizedMapping">
                        <Property Name="Value" />
                      </Expression>
                      <Expression xsi:type="GreaterThan">
                        <Operand xsi:type="DoubleProperty">
                          <Value>0.9</Value>
                        </Operand>
                      </Expression>
                      <Expression xsi:type="rx:BehaviorSubject">
                        <Name>BC Threshold</Name>
                      </Expression>
                      <Expression xsi:type="WorkflowOutput" />
                    </Nodes>
                    <Edges>
                      <Edge From="0" To="1" Label="Source1" />
                      <Edge From="1" To="2" Label="Source1" />
                      <Edge From="2" To="3" Label="Source1" />
                      <Edge From="3" To="4" Label="Source1" />
                      <Edge From="4" To="6" Label="Source1" />
                      <Edge From="5" To="6" Label="Source2" />
                      <Edge From="6" To="7" Label="Source1" />
                      <Edge From="7" To="8" Label="Source1" />
                    </Edges>
                  </Workflow>
                </Builder>
              </Expression>
            </Nodes>
            <Edges>
              <Edge From="2" To="3" Label="Source1" />
              <Edge From="6" To="7" Label="Source1" />
            </Edges>
          </Workflow>
        </Builder>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Devices</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Disable">
              <Builder xsi:type="GroupWorkflow">
                <Name>Config</Name>
                <Workflow>
                  <Nodes>
                    <Expression xsi:type="Combinator">
                      <Combinator xsi:type="rx:Timer">
                        <rx:DueTime>PT1S</rx:DueTime>
                      </Combinator>
                    </Expression>
                    <Expression xsi:type="beh:CreateMessage">
                      <harp:MessageType>Write</harp:MessageType>
                      <harp:Payload xsi:type="beh:CreatePulseDO1Payload">
                        <beh:PulseDO1>100</beh:PulseDO1>
                      </harp:Payload>
                    </Expression>
                    <Expression xsi:type="beh:CreateMessage">
                      <harp:MessageType>Write</harp:MessageType>
                      <harp:Payload xsi:type="beh:CreatePulseDO2Payload">
                        <beh:PulseDO2>100</beh:PulseDO2>
                      </harp:Payload>
                    </Expression>
                    <Expression xsi:type="beh:CreateMessage">
                      <harp:MessageType>Write</harp:MessageType>
                      <harp:Payload xsi:type="beh:CreateOutputPulseEnablePayload">
                        <beh:OutputPulseEnable>DO1 DO2</beh:OutputPulseEnable>
                      </harp:Payload>
                    </Expression>
                    <Expression xsi:type="Combinator">
                      <Combinator xsi:type="rx:Merge" />
                    </Expression>
                    <Expression xsi:type="MulticastSubject">
                      <Name>BehaviorCommands</Name>
                    </Expression>
                  </Nodes>
                  <Edges>
                    <Edge From="0" To="1" Label="Source1" />
                    <Edge From="0" To="2" Label="Source1" />
                    <Edge From="0" To="3" Label="Source1" />
                    <Edge From="1" To="4" Label="Source1" />
                    <Edge From="2" To="4" Label="Source2" />
                    <Edge From="3" To="4" Label="Source3" />
                    <Edge From="4" To="5" Label="Source1" />
                  </Edges>
                </Workflow>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="IncludeWorkflow" Path="UclOpen.Devices:TriggeredSpinnaker.bonsai">
                <ExposureTime>19000</ExposureTime>
                <Gain>0</Gain>
                <Binning>1</Binning>
                <SerialNumber>26310540</SerialNumber>
                <ColorProcessing>Default</ColorProcessing>
                <CameraTriggerEventsSubjectName>Camera0TriggerEvents</CameraTriggerEventsSubjectName>
                <FrameEventsSubjectName>FrameEvents</FrameEventsSubjectName>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.BehaviorBoard.bonsai">
                <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
                <PortName>COM8</PortName>
                <DumpRegisters>true</DumpRegisters>
                <Heartbeat>Enabled</Heartbeat>
                <EventsSubjectName>BehaviorEvents</EventsSubjectName>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="harp:FilterRegister">
                <harp:FilterType>Include</harp:FilterType>
                <harp:Register xsi:type="harp:TimestampSeconds" />
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.CameraTriggerController.bonsai">
                <Trigger0Frequency>150</Trigger0Frequency>
                <Trigger1Frequency>50</Trigger1Frequency>
                <BehaviorCommandsSubjectName>BehaviorCommands</BehaviorCommandsSubjectName>
                <BehaviorEventsSubjectName>BehaviorEvents</BehaviorEventsSubjectName>
                <Camera0TriggerEventsSubjectName>Camera0TriggerEvents</Camera0TriggerEventsSubjectName>
                <Camera1TriggerEventsSubjectName>Camera1TriggerEvents</Camera1TriggerEventsSubjectName>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="IncludeWorkflow" Path="UclOpen.Devices:LicketySplit.bonsai">
                <CommandsSubjectName>LickCommandsR</CommandsSubjectName>
                <PortName>COM9</PortName>
                <DumpRegisters>true</DumpRegisters>
                <Heartbeat>Enabled</Heartbeat>
                <EventsSubjectName>LickEventsR</EventsSubjectName>
                <Channel0TriggerThreshold>0</Channel0TriggerThreshold>
                <Channel0UntriggerThreshold>0</Channel0UntriggerThreshold>
                <LickStateSubjectName>LickStateR</LickStateSubjectName>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="harp:FilterRegister">
                <harp:FilterType>Include</harp:FilterType>
                <harp:Register xsi:type="harp:TimestampSeconds" />
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="IncludeWorkflow" Path="UclOpen.Devices:LicketySplit.bonsai">
                <CommandsSubjectName>LickCommandsL</CommandsSubjectName>
                <PortName>COM8</PortName>
                <DumpRegisters>true</DumpRegisters>
                <Heartbeat>Enabled</Heartbeat>
                <EventsSubjectName>LickEventsL</EventsSubjectName>
                <Channel0TriggerThreshold>0</Channel0TriggerThreshold>
                <Channel0UntriggerThreshold>0</Channel0UntriggerThreshold>
                <LickStateSubjectName>LickStateL</LickStateSubjectName>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="harp:FilterRegister">
                <harp:FilterType>Include</harp:FilterType>
                <harp:Register xsi:type="harp:TimestampSeconds" />
              </Builder>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>Arduino</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="port:CreateSerialPort">
                      <port:Name>ArduinoPort</port:Name>
                      <port:PortName>COM10</port:PortName>
                      <port:BaudRate>115200</port:BaudRate>
                      <port:NewLine>\n</port:NewLine>
                      <port:Parity>None</port:Parity>
                      <port:ParityReplace>63</port:ParityReplace>
                      <port:DataBits>8</port:DataBits>
                      <port:StopBits>One</port:StopBits>
                      <port:Handshake>None</port:Handshake>
                      <port:DiscardNull>false</port:DiscardNull>
                      <port:DtrEnable>true</port:DtrEnable>
                      <port:RtsEnable>false</port:RtsEnable>
                      <port:ReadBufferSize>4096</port:ReadBufferSize>
                      <port:WriteBufferSize>2048</port:WriteBufferSize>
                      <port:ReceivedBytesThreshold>1</port:ReceivedBytesThreshold>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Timer">
                      <rx:DueTime>PT1S</rx:DueTime>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="StringProperty">
                      <Value>L,1,255,255,255</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="port:SerialWriteLine">
                      <port:PortName>ArduinoPort</port:PortName>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Timer">
                      <rx:DueTime>PT2S</rx:DueTime>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="StringProperty">
                      <Value>X</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="port:SerialWriteLine">
                      <port:PortName>ArduinoPort</port:PortName>
                    </Combinator>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>Transceivers</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>AsciiMode</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>NumPad0</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>0</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>NumPad1</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>1</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>NumPad2</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>2</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>NumPad3</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>3</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>NumPad4</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>4</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>NumPad5</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>5</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>NumPad6</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>6</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>NumPad7</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>7</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>NumPad8</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>8</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>NumPad9</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>9</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>Space</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>Return</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>Delete</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>Back</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>X</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>X</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p1:AVA_AsciiMessage">
                            <p1:LedColor>255,255,255</p1:LedColor>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="port:SerialWriteLine">
                            <port:PortName>ArduinoPort</port:PortName>
                          </Combinator>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="26" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="3" To="26" Label="Source2" />
                        <Edge From="4" To="5" Label="Source1" />
                        <Edge From="5" To="26" Label="Source3" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="7" To="26" Label="Source4" />
                        <Edge From="8" To="9" Label="Source1" />
                        <Edge From="9" To="26" Label="Source5" />
                        <Edge From="10" To="11" Label="Source1" />
                        <Edge From="11" To="26" Label="Source6" />
                        <Edge From="12" To="13" Label="Source1" />
                        <Edge From="13" To="26" Label="Source7" />
                        <Edge From="14" To="15" Label="Source1" />
                        <Edge From="15" To="26" Label="Source8" />
                        <Edge From="16" To="17" Label="Source1" />
                        <Edge From="17" To="26" Label="Source9" />
                        <Edge From="18" To="19" Label="Source1" />
                        <Edge From="19" To="26" Label="Source10" />
                        <Edge From="20" To="21" Label="Source1" />
                        <Edge From="21" To="26" Label="Source11" />
                        <Edge From="22" To="23" Label="Source1" />
                        <Edge From="23" To="26" Label="Source12" />
                        <Edge From="24" To="25" Label="Source1" />
                        <Edge From="25" To="26" Label="Source13" />
                        <Edge From="26" To="27" Label="Source1" />
                        <Edge From="27" To="28" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>BitmaskMode</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="wie:KeyDown">
                            <wie:Filter>Space</wie:Filter>
                            <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p1:AVA_RandomPattern">
                            <p1:NumLeds>16</p1:NumLeds>
                            <p1:OnProbability>0.3</p1:OnProbability>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p1:AVA_BitmaskMessage">
                            <p1:LedColor>255,255,255</p1:LedColor>
                            <p1:Staged>true</p1:Staged>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="port:SerialWrite">
                            <port:PortName>ArduinoPort</port:PortName>
                          </Combinator>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="wie:KeyDown">
                      <wie:Filter>A</wie:Filter>
                      <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p1:AVA_ModeToggle">
                      <p1:Mode>ASCII</p1:Mode>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="wie:KeyDown">
                      <wie:Filter>B</wie:Filter>
                      <wie:SuppressRepetitions>true</wie:SuppressRepetitions>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p1:AVA_ModeToggle">
                      <p1:Mode>Bitmask</p1:Mode>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Disable">
                    <Builder xsi:type="Combinator">
                      <Combinator xsi:type="port:SerialReadLine">
                        <port:PortName>ArduinoPort</port:PortName>
                      </Combinator>
                    </Builder>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="GroupWorkflow">
          <Name>Instruments</Name>
          <Workflow>
            <Nodes>
              <Expression xsi:type="GroupWorkflow">
                <Name>Centroid</Name>
                <Workflow>
                  <Nodes>
                    <Expression xsi:type="SubscribeSubject">
                      <Name>BC Camera</Name>
                    </Expression>
                    <Expression xsi:type="Combinator">
                      <Combinator xsi:type="cv:Threshold">
                        <cv:ThresholdValue>128</cv:ThresholdValue>
                        <cv:MaxValue>255</cv:MaxValue>
                        <cv:ThresholdType>Binary</cv:ThresholdType>
                      </Combinator>
                    </Expression>
                    <Expression xsi:type="Combinator">
                      <Combinator xsi:type="cv:FindContours">
                        <cv:Mode>ConnectedComponent</cv:Mode>
                        <cv:Method>ChainApproxNone</cv:Method>
                        <cv:Offset>
                          <cv:X>0</cv:X>
                          <cv:Y>0</cv:Y>
                        </cv:Offset>
                        <cv:MinArea xsi:nil="true" />
                        <cv:MaxArea xsi:nil="true" />
                      </Combinator>
                    </Expression>
                    <Expression xsi:type="Combinator">
